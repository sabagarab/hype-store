# Copy to .env.local and fill in. Never commit .env.local.

# Medusa backend URL and publishable API key (Admin > Settings > Publishable API Keys).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Public URL of this storefront.
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Fallback country code when the visitor's region can't be detected.
NEXT_PUBLIC_DEFAULT_REGION=lb

# Starter payment keys. Not used by this store (no Stripe); leave empty.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=

# Medusa Cloud S3 image host (optional).
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=

# Production product image host for next/image, e.g. the public R2 URL
# https://pub-xxxx.r2.dev (optional; see next.config.js).
IMAGE_HOST_URL=

# Shared secret for POST /api/revalidate; must equal
# STOREFRONT_REVALIDATE_SECRET in the backend env.
REVALIDATE_SECRET=
